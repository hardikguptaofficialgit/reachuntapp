# Vite dev — API is proxied to the FastAPI server by default.
# VITE_API_BASE=

# Main Linkit app URL for "Continue with Linkit"
VITE_LINKIT_APP_URL=http://localhost:8080

# Analytics (pick one provider — leave blank to disable)
# VITE_ANALYTICS_DISABLED=true

# Umami (recommended) — Settings → Websites → your site → Website ID
# Cloud script URL (default): https://cloud.umami.is/script.js
# Self-hosted: https://your-umami.example.com/script.js
# VITE_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Plausible / GA4 (alternatives)
# VITE_PLAUSIBLE_DOMAIN=founderemail.example.com
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
