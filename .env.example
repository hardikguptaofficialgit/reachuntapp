# Copy to .env and adjust values for your machine.

APP_SECRET=change-me-in-production
REQUIRE_AUTH=false

# Main Linkit web app (sign-in redirect target)
LINKIT_APP_URL=http://localhost:8080

# Optional Firebase Admin / Linkit auth.
# Required only when REQUIRE_AUTH=true.
# Option A: point at a backend folder containing serviceAccountKey.json
# LINKIT_V5_BACKEND=C:\path\to\linkit\backend
# Option B: direct path to the JSON file
# LINKIT_SERVICE_ACCOUNT_PATH=C:\path\to\serviceAccountKey.json
# Option C: multiple backend dirs (comma- or semicolon-separated)
# LINKIT_V5_BACKEND_PATHS=C:\path\to\backend-one;C:\path\to\backend-two
#
# You can also use FIREBASE_* env vars if your deployment already provides them.

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DuckDuckGo profile discovery (pip package: ddgs)
DDG_SEARCH_ENABLED=true
DDG_MAX_RESULTS=12
# DDGS_PROXY=socks5://127.0.0.1:9150
# DDG_TIMEOUT_SEC=15

# Email order: Mailmeteor primary, strict custom finder fallback.
# Public emails must match the person's name and pass validation.
# Pattern guesses are returned only if CUSTOM_EMAIL_PATTERN_SMTP=true and SMTP accepts.
CUSTOM_EMAIL_FINDER=true
CUSTOM_EMAIL_PUBLIC_SEARCH=true
CUSTOM_EMAIL_SITE_SCRAPE=true
CUSTOM_EMAIL_PATTERN_SMTP=false
CUSTOM_EMAIL_PATTERN_GUESS=true
# CUSTOM_EMAIL_PATTERN_GUESS_MIN_CONFIDENCE=80
# CUSTOM_EMAIL_PATTERN_OVERRIDES=nvidia.com:{f}{last};openai.com:{first}
# CUSTOM_EMAIL_TIMEOUT_SEC=6
# CUSTOM_EMAIL_MAX_PAGES=6
# CUSTOM_EMAIL_MIN_CONFIDENCE=90

# Email validation. SMTP is stronger but slower and often blocked by mail hosts.
EMAIL_SMTP_VERIFY=false
# EMAIL_SMTP_TIMEOUT_SEC=8

# App branding
# APP_TITLE=Reachunt
# ANYONE_EMAIL_APP_ID=anyone-email
# Linkit SSO deployments may expect this source slug.
# LINKIT_SOURCE=founder-email

# Production API: DuckDuckGo finds public LinkedIn profiles; no per-user LinkedIn browser on server
# WEB_LINKEDIN_CLIENT_MODE=true

# Production database (optional; default data/webapp.db with WAL)
# DATABASE_PATH=/var/lib/anyone-email/webapp.db
# SHARED_LOOKUP_CACHE_TTL_DAYS=180

# Cross-origin UI (e.g. Pages) + API subdomain - set cookie domain + secure
# COOKIE_DOMAIN=.yourdomain.com
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# Job queue - Mailmeteor serialized; DDG profile discovery is lightweight
# JOB_WORKER_COUNT=1
# LINKEDIN_MAX_CONCURRENT=4
# LOOKUP_MAX_SEC=120
# CUSTOM_EMAIL_BUDGET_SEC=8
# MAILMETEOR_LOOKUP_BUDGET_SEC=45
# MAILMETEOR_NOT_FOUND_TIMEOUT_SEC=18
# RATE_LIMIT_LOOKUPS_PER_MIN=20

# Groq - AI build prompts (https://console.groq.com)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_API_BASE=https://api.groq.com/openai/v1
# BUILD_PROMPT_DAILY_LIMIT=3
