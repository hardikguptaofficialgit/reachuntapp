# Copy to .env and adjust paths for your machine.

APP_SECRET=change-me-in-production
REQUIRE_AUTH=true

# Main Linkit web app (sign-in redirect target)
LINKIT_APP_URL=http://localhost:8080

# Firebase Admin — same project as linkit-studio (linkit_v5)
# Option A: point at linkit_v5 backend folder (serviceAccountKey.json inside)
LINKIT_V5_BACKEND=C:\Disk E\Startups\Linkit\linkit_v5\backend
# Option B: direct path to the JSON file
# LINKIT_SERVICE_ACCOUNT_PATH=C:\Disk E\Startups\Linkit\linkit_v5\backend\serviceAccountKey.json
# Option C: multiple backend dirs (comma- or semicolon-separated)
# LINKIT_V5_BACKEND_PATHS=C:\Disk E\Startups\Linkit\linkit_v5\backend

# Or use the same FIREBASE_* env vars as linkit_v5 backend

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DuckDuckGo profile discovery (pip package: ddgs)
DDG_SEARCH_ENABLED=true
DDG_MAX_RESULTS=12
# DDGS_PROXY=socks5://127.0.0.1:9150
# DDG_TIMEOUT_SEC=15

# App branding (Linkit SSO still uses LINKIT_SOURCE=founder-email by default)
# APP_TITLE=Reachunt
# ANYONE_EMAIL_APP_ID=anyone-email
# LINKIT_SOURCE=founder-email

# Production API: LinkedIn opens in the user's browser; lookups use DuckDuckGo (no per-user Chrome on server)
# WEB_LINKEDIN_CLIENT_MODE=true

# Production database (optional; default data/webapp.db with WAL)
# DATABASE_PATH=/var/lib/anyone-email/webapp.db

# Cross-origin UI (e.g. Vercel) + API subdomain — set cookie domain + secure
# COOKIE_DOMAIN=.yourdomain.com
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# Job queue — Mailmeteor serialized; LinkedIn parallel pool
# JOB_WORKER_COUNT=1
# LINKEDIN_MAX_CONCURRENT=4
# LOOKUP_MAX_SEC=120
# RATE_LIMIT_LOOKUPS_PER_MIN=20

# Groq — AI build prompts (https://console.groq.com)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_API_BASE=https://api.groq.com/openai/v1
# BUILD_PROMPT_DAILY_LIMIT=3
