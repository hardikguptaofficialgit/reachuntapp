# Droplet production — reachunt.arclabs.page (Pages) + apimail.arclabs.page (API)
# Copy to /home/deploy/anyone-email/.env on the server.

ENV=production
APP_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

REQUIRE_AUTH=true
LINKIT_APP_URL=https://linkitapp.in
LINKIT_SOURCE=founder-email
LINKIT_SERVICE_ACCOUNT_PATH=/home/deploy/secrets/serviceAccountKey.json

# Cloudflare Pages UI origin
CORS_ORIGINS=https://reachunt.arclabs.page

# HTTPS cookies (same site family: *.arclabs.page)
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=.arclabs.page

# Linux droplet — use Chrome (install google-chrome-stable)
WEB_BROWSER=chrome
# BROWSER_EXE=/usr/bin/google-chrome-stable

WEB_MAILMETEOR_PORT=9224
WEB_LINKEDIN_PORT_BASE=9300

JOB_WORKER_COUNT=1
LINKEDIN_MAX_CONCURRENT=1
DDG_SEARCH_ENABLED=true
EMAIL_API_FIRST=false
FAST_LOOKUP=true

DATABASE_PATH=/home/deploy/anyone-email/data/webapp.db
GROQ_API_KEY=
